@* Botão mostrar/ocultar senha (comportamento em wwwroot/js/personalhub.js). *@
<button type="button" class="ph-password-toggle" data-ph-password-toggle="@For" aria-controls="@For" aria-label="Mostrar senha">
    <svg class="ph-icon-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
    <svg class="ph-icon-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10.7 5.1A10.4 10.4 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-2.2 3.2M6.6 6.6C3.9 8.4 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2M2 2l20 20" /></svg>
</button>

@code {
    /// <summary>Id do input de senha controlado.</summary>
    [Parameter, EditorRequired]
    public string For { get; set; } = default!;
}
