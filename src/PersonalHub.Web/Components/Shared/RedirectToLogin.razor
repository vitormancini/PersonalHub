@inject NavigationManager Navigation

@code {
    // Rede de segurança para páginas interativas. Em SSR estático, o middleware de autorização já redireciona.
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/entrar?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
