@page "/Error"

<PageTitle>Erro</PageTitle>

<h1 class="h3">Algo deu errado</h1>
<p>Não foi possível concluir sua solicitação. Tente novamente em instantes.</p>

@if (!string.IsNullOrEmpty(CorrelationId))
{
    <p class="text-secondary small">
        Se precisar de ajuda, informe o código: <code>@CorrelationId</code>
    </p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? CorrelationId { get; set; }

    // O CorrelationIdMiddleware grava o correlation ID no TraceIdentifier.
    protected override void OnInitialized() => CorrelationId = HttpContext?.TraceIdentifier;
}
