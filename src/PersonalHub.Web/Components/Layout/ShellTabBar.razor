@inject NavigationManager Navigation

@* Barra de abas fixa no rodapé das áreas logadas (personal e aluno), pensada para o polegar no celular. *@
<nav class="ph-tabbar" aria-label="Navegação principal">
    <div class="ph-tabbar-inner ph-tabbar-@Tabs.Count">
        @foreach (var tab in Tabs)
        {
            var active = IsActive(tab);
            <a href="@tab.Href" class="ph-tab @(active ? "is-active" : null)" aria-current="@(active ? "page" : null)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)tab.Icon)</svg>
                <span>@tab.Label</span>
            </a>
        }
    </div>
</nav>

@code {
    public sealed record Tab(string Label, string Href, bool Exact, string Icon);

    public const string HomeIcon = "<path d=\"m3 10 9-7 9 7v10a2 2 0 0 1-2 2h-4v-7H9v7H5a2 2 0 0 1-2-2z\" />";
    public const string LessonsIcon = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" /><path d=\"M16 2v4M8 2v4M3 10h18\" />";
    public const string MoneyIcon = "<rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\" /><circle cx=\"12\" cy=\"12\" r=\"2\" /><path d=\"M6 12h.01M18 12h.01\" />";

    [Parameter, EditorRequired]
    public IReadOnlyList<Tab> Tabs { get; set; } = default!;

    private bool IsActive(Tab tab)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return tab.Exact
            ? string.Equals(path, tab.Href, StringComparison.OrdinalIgnoreCase)
            : path.Equals(tab.Href, StringComparison.OrdinalIgnoreCase)
              || path.StartsWith(tab.Href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
