@inherits LayoutComponentBase

<div class="ph-app">
    <header class="ph-app-header">
        <div class="ph-app-header-inner">
            <PhLogo Class="ph-logo-sm" />
            @* POST com antiforgery: um link GET permitiria deslogar o usuário a partir de outro site. *@
            <form method="post" action="/sair" class="m-0">
                <AntiforgeryToken />
                <button type="submit" class="ph-btn ph-btn-on-dark">Sair</button>
            </form>
        </div>
    </header>

    <main class="ph-app-main">
        @Body
    </main>
</div>
