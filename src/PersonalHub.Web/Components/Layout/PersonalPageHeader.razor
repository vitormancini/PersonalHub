@* Preenche o cabeçalho do PersonalLayout: título (também usado no <title>) e, opcionalmente, o botão voltar
   e um link de ação à direita (por exemplo, "Editar"). *@

<PageTitle>@Title · PersonalHub</PageTitle>

<SectionContent SectionName="@TitleSection">@Title</SectionContent>

@if (BackHref is not null)
{
    <SectionContent SectionName="@BackSection">
        <a href="@BackHref" class="ph-shell-back" aria-label="@BackLabel">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" /></svg>
        </a>
    </SectionContent>
}

@if (ActionHref is not null)
{
    <SectionContent SectionName="@ActionSection">
        <a href="@ActionHref" class="ph-btn ph-btn-on-dark ph-btn-sm">@ActionLabel</a>
    </SectionContent>
}

@code {
    public const string TitleSection = "ph-shell-title";
    public const string BackSection = "ph-shell-back";
    public const string ActionSection = "ph-shell-action";

    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    [Parameter]
    public string? BackHref { get; set; }

    [Parameter]
    public string BackLabel { get; set; } = "Voltar";

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public string? ActionLabel { get; set; }
}
