@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* Área do personal: cabeçalho azul-marinho (voltar + título, definidos pela página com <PersonalPageHeader>)
   e barra de abas fixa no rodapé, pensada para o polegar no celular. *@
<div class="ph-shell">
    <header class="ph-shell-header">
        <div class="ph-shell-header-inner">
            <SectionOutlet SectionName="@PersonalPageHeader.BackSection" />
            <h1 class="ph-shell-title" tabindex="-1"><SectionOutlet SectionName="@PersonalPageHeader.TitleSection" /></h1>
            @* POST com antiforgery: um link GET permitiria deslogar o usuário a partir de outro site. *@
            <form method="post" action="/sair" class="m-0">
                <AntiforgeryToken />
                <button type="submit" class="ph-btn ph-btn-on-dark ph-btn-sm">Sair</button>
            </form>
        </div>
    </header>

    <main class="ph-shell-main">
        @Body
    </main>

    <nav class="ph-tabbar" aria-label="Navegação principal">
        <div class="ph-tabbar-inner">
            @foreach (var tab in Tabs)
            {
                var active = IsActive(tab);
                <a href="@tab.Href" class="ph-tab @(active ? "is-active" : null)" aria-current="@(active ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)tab.Icon)</svg>
                    <span>@tab.Label</span>
                </a>
            }
        </div>
    </nav>
</div>

@code {
    private sealed record Tab(string Label, string Href, bool Exact, string Icon);

    private static readonly Tab[] Tabs =
    [
        new("Início", "/personal", true, "<path d=\"m3 10 9-7 9 7v10a2 2 0 0 1-2 2h-4v-7H9v7H5a2 2 0 0 1-2-2z\" />"),
        new("Aulas", "/personal/aulas", false, "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" /><path d=\"M16 2v4M8 2v4M3 10h18\" />"),
        new("Alunos", "/personal/alunos", false, "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\" /><circle cx=\"9\" cy=\"7\" r=\"4\" /><path d=\"M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\" />"),
        new("Financeiro", "/personal/financeiro", false, "<rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\" /><circle cx=\"12\" cy=\"12\" r=\"2\" /><path d=\"M6 12h.01M18 12h.01\" />")
    ];

    private bool IsActive(Tab tab)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return tab.Exact
            ? string.Equals(path, tab.Href, StringComparison.OrdinalIgnoreCase)
            : path.Equals(tab.Href, StringComparison.OrdinalIgnoreCase)
              || path.StartsWith(tab.Href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
