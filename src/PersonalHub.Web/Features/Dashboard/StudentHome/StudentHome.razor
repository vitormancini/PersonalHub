@page "/aluno"
@attribute [Authorize(Roles = AppRoles.Student)]
@layout StudentLayout
@using PersonalHub.Web.Features.Authentication
@using PersonalHub.Web.Features.Lessons.StudentLessons
@using PersonalHub.Web.Features.Billing
@using PersonalHub.Web.Features.Billing.StudentPayments
@inject StudentLessonsQuery Lessons
@inject StudentPaymentsQuery Payments

@* Resumo provisório até a home do aluno (Fase 7): aulas esperando resposta e demonstrativos em aberto. *@

<PersonalPageHeader Title="Início" />

@if (_pending is null)
{
    return;
}

<div class="ph-detail">
    @if (_pending > 0)
    {
        <a href="/aluno/aulas" class="ph-list-item ph-home-pending">
            <span class="ph-counter-value">@_pending</span>
            <span class="ph-list-text">
                <span class="ph-list-title">@(_pending == 1 ? "Aula para confirmar" : "Aulas para confirmar")</span>
                <span class="ph-list-subtitle">Confira e responda em Minhas aulas.</span>
            </span>
            <svg class="ph-list-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    }
    else
    {
        <div class="ph-card">
            <p class="mb-0">Tudo em dia. Nenhuma aula esperando sua confirmação.</p>
        </div>
    }

    @if (_open is { Count: > 0 })
    {
        <a href="/aluno/pagamentos" class="ph-list-item ph-home-pending">
            <span class="ph-counter-value">@_open.Count</span>
            <span class="ph-list-text">
                <span class="ph-list-title">@(_open.Count == 1 ? "Demonstrativo para pagar" : "Demonstrativos para pagar")</span>
                <span class="ph-list-subtitle">@OpenSubtitle</span>
            </span>
            <svg class="ph-list-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    }
    else
    {
        <div class="ph-card">
            <p class="mb-0">Nenhum demonstrativo em aberto.</p>
        </div>
    }

    <div class="ph-grid-2">
        <a href="/aluno/aulas" class="ph-btn ph-btn-outline">Ver minhas aulas</a>
        <a href="/aluno/pagamentos" class="ph-btn ph-btn-outline">Ver pagamentos</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private int? _pending;
    private StudentOpenSummary? _open;

    private string OpenSubtitle => _open switch
    {
        { Reported: var r, Count: var c } when r == c => r == 1
            ? "Pagamento informado. Aguardando o personal confirmar."
            : "Pagamentos informados. Aguardando o personal confirmar.",
        { Reported: > 0 } => $"Total de {BillingDisplay.Money(_open.Total)}. {(_open.Reported == 1 ? "1 aguarda" : $"{_open.Reported} aguardam")} o personal confirmar.",
        _ => $"Total de {BillingDisplay.Money(_open!.Total)}. Veja em Pagamentos."
    };

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUser.IdOf(HttpContext.User)!.Value;
        _pending = await Lessons.PendingCountAsync(userId, HttpContext.RequestAborted);
        _open = await Payments.OpenSummaryAsync(userId, HttpContext.RequestAborted);
    }
}
