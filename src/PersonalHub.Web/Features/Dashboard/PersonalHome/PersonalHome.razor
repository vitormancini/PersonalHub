@page "/personal"
@attribute [Authorize(Policy = AppPolicies.ActivePersonal)]
@layout PersonalLayout
@using PersonalHub.Web.Features.Authentication
@using PersonalHub.Web.Features.Billing.PersonalBilling

@inject PersonalBillingQuery Billing

@* Resumo provisório até a home do personal (Fase 7): pagamentos informados aguardando confirmação. *@

<PersonalPageHeader Title="Início" />

<div class="ph-detail">
    @if (_toConfirm > 0)
    {
        <a href="/personal/financeiro" class="ph-list-item ph-home-pending">
            <span class="ph-counter-value">@_toConfirm</span>
            <span class="ph-list-text">
                <span class="ph-list-title">@(_toConfirm == 1 ? "Pagamento para confirmar" : "Pagamentos para confirmar")</span>
                <span class="ph-list-subtitle">Confira se recebeu e confirme no Financeiro.</span>
            </span>
            <svg class="ph-list-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    }

    <div class="ph-card">
        <p>
            Esta área está em construção. Em breve você vai registrar aulas, acompanhar alunos e ver o faturamento por aqui.
        </p>
        <a href="/personal/alunos/novo" class="ph-btn ph-btn-primary ph-btn-block">Novo aluno</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private int _toConfirm;

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUser.IdOf(HttpContext.User)!.Value;
        _toConfirm = await Billing.ToConfirmCountAsync(userId, HttpContext.RequestAborted);
    }
}
