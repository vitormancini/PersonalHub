@page "/entrar"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject LoginHandler Handler
@inject NavigationManager Navigation

@* SSR estático (sem @rendermode): o cookie de login precisa ser gravado numa resposta HTTP, não pelo circuito SignalR. *@

<PageTitle>Entrar · PersonalHub</PageTitle>

<div class="ph-auth">
    <aside class="ph-auth-brand d-none d-md-flex">
        <PhLogo Class="ph-logo-lg" />
        <div>
            <h2 class="ph-auth-brand-title">Sua gestão de aulas,<br /><span class="ph-text-accent">muito mais simples.</span></h2>
            <ul class="ph-auth-features">
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4" /></svg>
                    <span>Registre aulas em poucos toques</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                    <span>Alunos confirmam cada aula</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /><path d="M14 2v4a2 2 0 0 0 2 2h4M8 13h8M8 17h8M8 9h2" /></svg>
                    <span>Demonstrativo mensal sem planilha</span>
                </li>
            </ul>
        </div>
        <p class="ph-auth-brand-footer">© PersonalHub</p>
    </aside>

    <header class="ph-auth-hero d-md-none">
        <PhLogo />
        <h1 class="ph-auth-hero-title">Bem-vindo de volta</h1>
        <p class="ph-auth-hero-text">Entre para registrar e acompanhar suas aulas.</p>
    </header>

    <main class="ph-auth-main">
        <div class="ph-auth-card">
            <div class="ph-auth-card-header d-none d-md-block">
                <h1 class="ph-auth-card-title">Entrar</h1>
                <p class="ph-auth-card-text">Use o e-mail e a senha da sua conta.</p>
            </div>

            <EditForm Model="Input" FormName="login" OnSubmit="SubmitAsync" novalidate class="ph-form" data-ph-busy-form>
                <DataAnnotationsValidator />

                @if (_outcome == LoginOutcome.InvalidCredentials)
                {
                    <div class="ph-alert ph-alert-danger" role="alert">
                        <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                        <p><strong>E-mail ou senha incorretos.</strong> Confira os dados e tente de novo.</p>
                    </div>
                }
                else if (_outcome == LoginOutcome.LockedOut)
                {
                    <div class="ph-alert ph-alert-warning" role="alert">
                        <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <p><strong>Acesso bloqueado por 15 minutos</strong> após várias tentativas sem sucesso. Tente de novo depois desse prazo.</p>
                    </div>
                }

                <div class="ph-field">
                    <label for="login-email" class="ph-label">E-mail</label>
                    <InputText id="login-email" type="email" @bind-Value="Input.Email" class="ph-input"
                               autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false"
                               placeholder="voce@exemplo.com" aria-describedby="login-email-error" />
                    <ValidationMessage For="() => Input.Email" id="login-email-error" class="ph-field-error" />
                </div>

                <div class="ph-field">
                    <label for="login-password" class="ph-label">Senha</label>
                    <div class="ph-password">
                        <InputText id="login-password" type="password" @bind-Value="Input.Password" class="ph-input"
                                   autocomplete="current-password" aria-describedby="login-password-error" />
                        <PasswordToggle For="login-password" />
                    </div>
                    <ValidationMessage For="() => Input.Password" id="login-password-error" class="ph-field-error" />
                </div>

                <label class="ph-check">
                    <InputCheckbox @bind-Value="Input.RememberMe" class="ph-check-input" />
                    <span>Manter conectado</span>
                </label>

                <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Entrando…">
                    <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span class="ph-btn-text">Entrar</span>
                </button>
            </EditForm>

            <p class="ph-auth-note">É aluno e recebeu um convite? Abra o link do convite para criar sua senha.</p>
        </div>
    </main>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    // Preenchido pelo middleware de cookie ao barrar uma página protegida (/entrar?ReturnUrl=/personal).
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? RequestedReturnUrl { get; set; }

    private LoginOutcome? _outcome;
    private bool _redirecting;

    protected override void OnInitialized()
    {
        Input ??= new LoginInput();

        // Quem já está logado não precisa ver o login.
        var home = UserHome.For(HttpContext.User);
        if (home is not null)
        {
            _redirecting = true;
            Navigation.NavigateTo(home);
        }
    }

    private async Task SubmitAsync(EditContext editContext)
    {
        if (_redirecting)
        {
            return;
        }

        var valid = editContext.Validate();
        if (valid)
        {
            var result = await Handler.HandleAsync(
                new LoginCommand(Input.Email!, Input.Password!, Input.RememberMe), HttpContext.RequestAborted);

            if (result.Outcome == LoginOutcome.Succeeded)
            {
                // Só caminhos locais: um ReturnUrl externo seria um open redirect.
                Navigation.NavigateTo(ReturnUrl.IsLocal(RequestedReturnUrl) ? RequestedReturnUrl! : result.HomeUrl!);
                return;
            }

            _outcome = result.Outcome;
        }

        // A senha nunca volta no HTML da resposta.
        Input.Password = string.Empty;
    }
}
