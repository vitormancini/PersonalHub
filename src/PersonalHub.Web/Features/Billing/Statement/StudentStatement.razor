@page "/aluno/pagamentos/{BillingPeriodId:guid}"
@attribute [Authorize(Roles = AppRoles.Student)]
@layout StudentLayout
@using PersonalHub.Web.Domain
@using PersonalHub.Web.Domain.Billing
@using PersonalHub.Web.Features.Authentication
@using PersonalHub.Web.Features.Billing
@using PersonalHub.Web.Features.Billing.Payments
@inject StatementQuery Query
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* O aluno vê só demonstrativos dos próprios vínculos (inclusive de vínculo inativo). "Já paguei" leva à tela de
   confirmação; o personal confere e confirma (D-049, D-050). *@

<PersonalPageHeader Title="Demonstrativo" BackHref="/aluno/pagamentos" BackLabel="Voltar para pagamentos" />

@if (_view is null)
{
    return;
}

<div class="ph-detail">
    <PaymentNotice Code="@Aviso" ForStudent="true" />

    <div class="ph-lesson-head">
        <span class="ph-pill @BillingDisplay.StatusPillClass(_view.Status)">@BillingDisplay.StatusLabel(_view.Status)</span>
        <h2 class="ph-profile-name">@BillingDisplay.MonthYear(_view.ReferenceMonth)</h2>
        <p class="ph-lesson-when">Com @_view.PersonalName · vencimento @BillingDisplay.Date(_view.DueDate)</p>
    </div>

    @if (_view.Reported is { } reported)
    {
        <div class="ph-alert ph-alert-info">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 7v5l3 2" /></svg>
            <p>Você informou o pagamento em @BillingDisplay.DayMonthTime(reported.ReportedAtUtc). Agora o @_view.PersonalName confere e confirma o recebimento.</p>
        </div>
    }
    else if (_view.LastRejection is { } rejection)
    {
        <div class="ph-alert ph-alert-danger">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
            <div class="ph-alert-body">
                <p><strong>O @_view.PersonalName ainda não recebeu este pagamento.</strong></p>
                @if (rejection.DecisionNote is not null)
                {
                    <p class="ph-reason">"@rejection.DecisionNote"</p>
                }
                <p>Confira com ele e informe de novo quando estiver certo.</p>
            </div>
        </div>
    }
    else if (_view is { Status: BillingPeriodStatus.Paid, TotalAmount: > 0, PaidAtUtc: { } paidAt })
    {
        <div class="ph-alert ph-alert-success">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m8 12 3 3 5-6" /></svg>
            <p>Pagamento confirmado pelo @_view.PersonalName em @BillingDisplay.DayMonth(paidAt). Este demonstrativo está quitado.</p>
        </div>
    }

    <StatementBody View="_view" ForStudent="true" />

    @if (_view.TotalAmount > 0)
    {
        <PaymentHistory View="_view" ForStudent="true" Today="_today" />
    }

    @if (_view.Status == BillingPeriodStatus.Issued)
    {
        <section class="ph-stack-tight" aria-label="Pagamento">
            <a href="/aluno/pagamentos/@_view.Id/informar" class="ph-btn ph-btn-primary ph-btn-block">
                @(_view.LastRejection is null ? "Já paguei" : "Informar pagamento de novo")
            </a>
            <p class="ph-note ph-center-text">Pague direto ao @_view.PersonalName e avise aqui. Ele confirma quando receber.</p>
        </section>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid BillingPeriodId { get; set; }

    [SupplyParameterFromQuery(Name = "aviso")]
    private string? Aviso { get; set; }

    private StatementView? _view;
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        _today = SaoPaulo.ToLocalDate(Clock.GetUtcNow().UtcDateTime);
        var userId = CurrentUser.IdOf(HttpContext.User)!.Value;
        _view = await Query.ForStudentAsync(userId, BillingPeriodId, HttpContext.RequestAborted);
        if (_view is null)
        {
            // Demonstrativo de outro aluno ou inexistente: mesma resposta.
            Navigation.NotFound();
        }
    }
}
