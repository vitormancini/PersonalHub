@page "/nova-senha"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(PhoneVerification.PhoneVerificationServiceCollectionExtensions.RateLimitPolicy)]
@layout AuthLayout
@using PersonalHub.Web.Features.PhoneVerification
@inject PasswordResetHandler Handler
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* D-058. O e-mail chega protegido no parâmetro r (vindo de /esqueci-senha), nunca em texto puro. *@

<PageTitle>Nova senha · PersonalHub</PageTitle>

<div class="ph-auth ph-invite">
    <header class="ph-auth-hero">
        <div class="ph-invite-inner">
            <PhLogo />
            <h1 class="ph-auth-hero-title">Crie uma senha nova</h1>
            <p class="ph-auth-hero-text">Digite o código que chegou no WhatsApp e escolha a nova senha.</p>
        </div>
    </header>

    <main class="ph-auth-main">
        <div class="ph-invite-inner">
            @if (_expired)
            {
                <div class="ph-result">
                    <div class="ph-status-icon ph-status-warning" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 8v5M12 16.5h.01" /></svg>
                    </div>
                    <h2 class="ph-result-title">@PhoneCodeDisplay.Expired</h2>
                    <p class="ph-result-text">Os códigos valem por 10 minutos. Peça um novo para continuar.</p>
                </div>
                <a href="/esqueci-senha" class="ph-btn ph-btn-primary ph-btn-block">Pedir um código novo</a>
            }
            else
            {
                @if (_codeMessage is not null)
                {
                    <div class="ph-alert @(_codeMessageIsLock ? "ph-alert-warning" : "ph-alert-danger")" role="alert">
                        <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                        <p>@_codeMessage</p>
                    </div>
                }

                <EditForm EditContext="_context" FormName="nova-senha" OnSubmit="SubmitAsync" novalidate class="ph-form" data-ph-busy-form>
                    <div class="ph-field">
                        <label for="nova-senha-codigo" class="ph-label">Código do WhatsApp</label>
                        <InputText id="nova-senha-codigo" @bind-Value="Input.Code" class="ph-input ph-code-input"
                                   inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*"
                                   spellcheck="false" aria-describedby="nova-senha-codigo-error" />
                        <ValidationMessage For="() => Input.Code" id="nova-senha-codigo-error" class="ph-field-error" />
                    </div>

                    <div class="ph-field">
                        <label for="nova-senha" class="ph-label">Nova senha</label>
                        <div class="ph-password">
                            <InputText id="nova-senha" type="password" @bind-Value="Input.Password" class="ph-input"
                                       autocomplete="new-password" aria-describedby="nova-senha-regras nova-senha-error" />
                            <PasswordToggle For="nova-senha" />
                        </div>
                        <ul id="nova-senha-regras" class="ph-rules" data-ph-password-rules="nova-senha" aria-label="Regras da senha">
                            <li data-rule="length">8 ou mais caracteres</li>
                            <li data-rule="upper">Uma letra maiúscula</li>
                            <li data-rule="lower">Uma letra minúscula</li>
                            <li data-rule="digit">Um número</li>
                        </ul>
                        <ValidationMessage For="() => Input.Password" id="nova-senha-error" class="ph-field-error" />
                    </div>

                    <div class="ph-field">
                        <label for="nova-senha-confirmacao" class="ph-label">Confirme a nova senha</label>
                        <div class="ph-password">
                            <InputText id="nova-senha-confirmacao" type="password" @bind-Value="Input.ConfirmPassword" class="ph-input"
                                       autocomplete="new-password" aria-describedby="nova-senha-confirmacao-error" />
                            <PasswordToggle For="nova-senha-confirmacao" />
                        </div>
                        <ValidationMessage For="() => Input.ConfirmPassword" id="nova-senha-confirmacao-error" class="ph-field-error" />
                    </div>

                    <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Salvando…">
                        <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span class="ph-btn-text">Salvar nova senha</span>
                    </button>
                    <p class="ph-field-hint ph-text-center">Ao salvar, você sai da conta em todos os outros aparelhos.</p>
                </EditForm>
            }

            <a href="/entrar" class="ph-link-center">Voltar para o login</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "r")]
    private string? ResetToken { get; set; }

    [SupplyParameterFromForm(FormName = "nova-senha")]
    private NewPasswordInput Input { get; set; } = default!;

    private EditContext _context = default!;
    private ValidationMessageStore _messages = default!;
    private bool _expired;
    private string? _codeMessage;
    private bool _codeMessageIsLock;

    protected override void OnInitialized()
    {
        HttpContext.Response.Headers.CacheControl = "no-store";
        HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";
        HttpContext.Response.Headers["X-Robots-Tag"] = "noindex";
        Input ??= new NewPasswordInput();
        _context = new EditContext(Input);
        _messages = new ValidationMessageStore(_context);

        // Link adulterado ou com mais de 30 minutos: recomeça pelo e-mail. No POST o handler confere de novo.
        if (!HttpMethods.IsPost(HttpContext.Request.Method) && Handler.UnprotectEmail(ResetToken) is null)
        {
            Navigation.NavigateTo("/esqueci-senha");
        }
    }

    private async Task SubmitAsync()
    {
        var result = await Handler.ResetAsync(ResetToken, Input, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        Input.Password = Input.ConfirmPassword = string.Empty;
        var now = Clock.GetUtcNow().UtcDateTime;
        switch (result.Outcome)
        {
            case ResetPasswordOutcome.Succeeded:
                Navigation.NavigateTo("/entrar?senha=alterada");
                return;
            case ResetPasswordOutcome.LinkInvalid:
                Navigation.NavigateTo("/esqueci-senha");
                return;
            case ResetPasswordOutcome.Expired:
                _expired = true;
                return;
            case ResetPasswordOutcome.WrongCode:
                Input.Code = string.Empty;
                _codeMessage = PhoneCodeDisplay.Wrong(result.RemainingAttempts);
                return;
            case ResetPasswordOutcome.Locked:
                Input.Code = string.Empty;
                _codeMessage = PhoneCodeDisplay.Locked(result.LockedUntilUtc ?? now, now);
                _codeMessageIsLock = true;
                return;
            default:
                ServerValidation.Show(_context, _messages, result.Errors);
                return;
        }
    }
}
