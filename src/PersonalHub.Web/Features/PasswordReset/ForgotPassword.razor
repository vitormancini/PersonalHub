@page "/esqueci-senha"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(PhoneVerification.PhoneVerificationServiceCollectionExtensions.RateLimitPolicy)]
@layout AuthLayout
@inject PasswordResetHandler Handler

@* D-058. SSR estático. A resposta ao pedido é sempre a mesma, exista ou não a conta. *@

<PageTitle>Esqueci minha senha · PersonalHub</PageTitle>

<div class="ph-auth ph-invite">
    <header class="ph-auth-hero">
        <div class="ph-invite-inner">
            <PhLogo />
            <h1 class="ph-auth-hero-title">Esqueci minha senha</h1>
            <p class="ph-auth-hero-text">Enviamos um código pelo WhatsApp para você criar uma senha nova.</p>
        </div>
    </header>

    <main class="ph-auth-main">
        <div class="ph-invite-inner">
            @if (_resetToken is not null)
            {
                <div class="ph-result">
                    <div class="ph-status-icon ph-status-info" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.9-.9L3 20l1.1-4.6A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z" /></svg>
                    </div>
                    <h2 class="ph-result-title">Confira o WhatsApp</h2>
                    <p class="ph-result-text" role="status">Se esse e-mail tiver uma conta, o código chega no WhatsApp em instantes. Ele vale por 10 minutos.</p>
                </div>
                <a href="@NewPasswordUrl" class="ph-btn ph-btn-primary ph-btn-block">Já recebi o código</a>
            }
            else
            {
                <EditForm Model="Input" FormName="esqueci-senha" OnSubmit="SubmitAsync" novalidate class="ph-form" data-ph-busy-form>
                    <div class="ph-field">
                        <label for="esqueci-email" class="ph-label">E-mail da conta</label>
                        <InputText id="esqueci-email" type="email" @bind-Value="Input.Email" class="ph-input"
                                   autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false"
                                   placeholder="voce@exemplo.com" maxlength="256"
                                   aria-describedby="esqueci-email-error" aria-invalid="@(_error is null ? "false" : "true")" />
                        @if (_error is not null)
                        {
                            <div id="esqueci-email-error" class="ph-field-error">@_error</div>
                        }
                    </div>

                    <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Enviando…">
                        <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span class="ph-btn-text">Enviar código pelo WhatsApp</span>
                    </button>
                </EditForm>
            }

            <p class="ph-auth-note">Trocou de número ou não recebeu? Fale com o seu personal ou com o suporte.</p>
            <a href="/entrar" class="ph-link-center">Voltar para o login</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "esqueci-senha")]
    private ForgotPasswordInput Input { get; set; } = default!;

    private string? _error;
    private string? _resetToken;

    private string NewPasswordUrl => "/nova-senha?r=" + Uri.EscapeDataString(_resetToken!);

    protected override void OnInitialized()
    {
        HttpContext.Response.Headers.CacheControl = "no-store";
        HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";
        Input ??= new ForgotPasswordInput();
    }

    private async Task SubmitAsync()
    {
        var result = await Handler.RequestAsync(Input.Email, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        _error = result.Error;
        _resetToken = result.ResetToken;
    }

    public sealed class ForgotPasswordInput
    {
        public string? Email { get; set; }
    }
}
