@page "/personal/alunos/{PersonalStudentId:guid}"
@attribute [Authorize(Policy = AppPolicies.ActivePersonal)]
@layout PersonalLayout
@using PersonalHub.Web.Features.Authentication
@using PersonalHub.Web.Domain.Students
@using PersonalHub.Web.Features.Students.CreateStudent
@using PersonalHub.Web.Features.Students.ManageInvite
@using PersonalHub.Web.Domain
@using PersonalHub.Web.Features.Lessons.ListLessons
@inject StudentDetailsQuery Query
@inject ListLessonsQuery LessonsQuery
@inject TimeProvider Clock
@inject InviteActionsHandler InviteActions
@inject CreatedInviteHandoff Handoff
@inject NavigationManager Navigation

@* SSR estático. As ações do convite são POSTs com antiforgery; o novo link segue pelo mesmo cookie de leitura
   única do cadastro até a página "Convite do aluno" (o token nunca vai para a URL). *@

<PersonalPageHeader Title="Aluno" BackHref="/personal/alunos" BackLabel="Voltar para alunos"
                    ActionHref="@($"/personal/alunos/{PersonalStudentId}/editar")" ActionLabel="Editar" />

@if (_view is null)
{
    return;
}

<div class="ph-detail">
    @if (Notice is not null)
    {
        <div class="ph-alert ph-alert-success" role="status">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m8 12 3 3 5-6" /></svg>
            <p>@Notice</p>
        </div>
    }

    @if (_notInvited)
    {
        <div class="ph-alert ph-alert-warning" role="alert">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
            <p>Este aluno não está mais aguardando o convite. Confira a situação atual abaixo.</p>
        </div>
    }

    <div class="ph-profile">
        <span class="ph-avatar ph-avatar-lg" aria-hidden="true">@StudentDisplay.Initials(_view.StudentName)</span>
        <h2 class="ph-profile-name">@_view.StudentName</h2>
        <span class="ph-pill @StudentDisplay.StatusPillClass(_view.Status)">@StudentDisplay.StatusLabel(_view.Status)</span>
    </div>

    @if (_view.Status == PersonalStudentStatus.Invited)
    {
        <section class="ph-section-card" aria-labelledby="convite">
            <div class="ph-section-heading">
                <h3 id="convite" class="ph-section-title">Convite</h3>
                @switch (_view.Invite)
                {
                    case InviteStatus.Pending:
                        <span class="ph-pill ph-pill-pending">Aguardando aceite</span>
                        break;
                    case InviteStatus.Expired:
                        <span class="ph-pill ph-pill-muted">Expirado</span>
                        break;
                    default:
                        <span class="ph-pill ph-pill-muted">Cancelado</span>
                        break;
                }
            </div>

            <p class="ph-note">@InviteText(_view)</p>

            <form method="post" @formname="novo-link" @onsubmit="RenewAsync" class="ph-stack-tight" data-ph-busy-form>
                <AntiforgeryToken />
                <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Gerando…">
                    <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span class="ph-btn-text">Gerar novo link e enviar</span>
                </button>
                <p class="ph-caption">O link anterior deixa de funcionar na hora.</p>
            </form>

            @if (_view.Invite == InviteStatus.Pending)
            {
                <form method="post" @formname="cancelar-convite" @onsubmit="CancelAsync" class="ph-center" data-ph-busy-form>
                    <AntiforgeryToken />
                    <button type="submit" class="ph-btn ph-btn-danger-text" data-ph-busy-text="Cancelando…">
                        <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span class="ph-btn-text">Cancelar convite</span>
                    </button>
                </form>
            }
        </section>
    }
    else if (_view.Status == PersonalStudentStatus.Inactive)
    {
        <div class="ph-alert ph-alert-muted">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
            <p>
                Vínculo inativo desde @StudentDisplay.Date(_view.EndedAtUtc!.Value). O histórico de aulas e pagamentos
                continua disponível. Novas aulas não podem ser registradas.
            </p>
        </div>
    }

    <section class="ph-section-card" aria-labelledby="contato">
        <h3 id="contato" class="ph-section-title">Contato</h3>
        <dl class="ph-facts">
            <div>
                <dt>E-mail (login)</dt>
                <dd>@_view.StudentEmail</dd>
            </div>
            <div class="ph-fact-action">
                <div>
                    <dt>Celular</dt>
                    <dd>@BrazilianPhone.ToDisplay(_view.StudentPhone)</dd>
                </div>
                <a href="https://wa.me/@_view.StudentPhone.TrimStart('+')" target="_blank" rel="noopener noreferrer"
                   class="ph-btn ph-btn-outline ph-btn-sm" aria-label="Abrir conversa no WhatsApp com @_view.StudentName">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.5 8.5 0 1 1 21 11.5z" /></svg>
                    <span>WhatsApp</span>
                </a>
            </div>
        </dl>
    </section>

    <section class="ph-section-card" aria-labelledby="cobranca">
        <h3 id="cobranca" class="ph-section-title">Cobrança</h3>
        <dl class="ph-facts ph-facts-2">
            <div>
                <dt>Valor da aula</dt>
                <dd>@StudentDisplay.Money(_view.LessonPrice)</dd>
            </div>
            <div>
                <dt>Vencimento</dt>
                <dd>Dia @_view.BillingDueDay</dd>
            </div>
        </dl>
    </section>

    @if (_lessons is not null)
    {
        <section class="ph-section-card" aria-labelledby="aulas">
            <div class="ph-section-heading">
                <h3 id="aulas" class="ph-section-title">Aulas</h3>
                <span class="ph-note">@LessonDisplay.Month(_month)</span>
            </div>
            <dl class="ph-facts ph-facts-3">
                <div>
                    <dt>Aguardando</dt>
                    <dd>@_lessons.Pending</dd>
                </div>
                <div>
                    <dt>Confirmadas</dt>
                    <dd>@_lessons.Approved</dd>
                </div>
                <div>
                    <dt>Recusadas</dt>
                    <dd>@_lessons.Rejected</dd>
                </div>
            </dl>
            <div class="ph-grid-2">
                @if (_view.Status != PersonalStudentStatus.Inactive)
                {
                    <a href="/personal/aulas/nova?aluno=@PersonalStudentId" class="ph-btn ph-btn-outline">Registrar aula</a>
                }
                <a href="/personal/aulas?aluno=@PersonalStudentId" class="ph-btn ph-btn-outline">Ver aulas</a>
            </div>
        </section>
    }

    @if (_view.Status == PersonalStudentStatus.Inactive)
    {
        <a href="/personal/alunos/@PersonalStudentId/vinculo" class="ph-btn ph-btn-primary ph-btn-block">Reativar vínculo</a>
    }
    else
    {
        <a href="/personal/alunos/@PersonalStudentId/vinculo" class="ph-btn ph-btn-danger-outline ph-btn-block">Inativar vínculo</a>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid PersonalStudentId { get; set; }

    [SupplyParameterFromQuery(Name = "aviso")]
    private string? Aviso { get; set; }

    private StudentDetailsView? _view;
    private bool _notInvited;
    private LessonCounts? _lessons;
    private DateOnly _month;

    /// <summary>Mensagem de sucesso depois de um redirecionamento (PRG). Só textos fixos: nada vem da URL para a tela.</summary>
    private string? Notice => Aviso switch
    {
        "salvo" => "Alterações salvas.",
        "convite-cancelado" => "Convite cancelado. O link enviado não funciona mais.",
        "inativado" => "Vínculo inativado.",
        "reativado" => "Vínculo reativado.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _view = await Query.GetAsync(UserId, PersonalStudentId, HttpContext.RequestAborted);
        if (_view is null)
        {
            // Vínculo de outro personal ou inexistente: mesma resposta, sem revelar qual dos dois.
            Navigation.NotFound();
            return;
        }

        // Resumo do mês corrente (D-026): o detalhe completo fica na lista de aulas filtrada pelo aluno.
        var today = SaoPaulo.ToLocalDate(Clock.GetUtcNow().UtcDateTime);
        _month = new DateOnly(today.Year, today.Month, 1);
        _lessons = await LessonsQuery.CountsAsync(UserId, _month, PersonalStudentId, HttpContext.RequestAborted);
    }

    private Guid UserId => CurrentUser.IdOf(HttpContext.User)!.Value;

    private async Task RenewAsync()
    {
        var result = await InviteActions.RenewAsync(UserId, PersonalStudentId, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        if (result.Outcome == InviteActionOutcome.Succeeded)
        {
            Handoff.Store(HttpContext, UserId, PersonalStudentId, result.InviteToken!);
            Navigation.NavigateTo($"/personal/alunos/{PersonalStudentId}/convite-criado");
            return;
        }

        await HandleFailureAsync(result.Outcome);
    }

    private async Task CancelAsync()
    {
        var result = await InviteActions.CancelAsync(UserId, PersonalStudentId, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        if (result.Outcome == InviteActionOutcome.Succeeded)
        {
            Navigation.NavigateTo($"/personal/alunos/{PersonalStudentId}?aviso=convite-cancelado");
            return;
        }

        await HandleFailureAsync(result.Outcome);
    }

    private async Task HandleFailureAsync(InviteActionOutcome outcome)
    {
        if (outcome == InviteActionOutcome.NotFound)
        {
            _view = null;
            Navigation.NotFound();
            return;
        }

        // O aluno aceitou ou o vínculo foi inativado entre abrir a página e enviar: mostra a situação atual.
        _notInvited = true;
        Aviso = null;
        await LoadAsync();
    }

    private static string InviteText(StudentDetailsView view) => view.Invite switch
    {
        InviteStatus.Pending =>
            $"Link gerado em {StudentDisplay.Date(view.InviteCreatedAtUtc!.Value)}. Vale até " +
            $"{StudentDisplay.Date(view.InviteExpiresAtUtc!.Value)} e só pode ser usado uma vez. " +
            "Se o aluno não recebeu ou perdeu a mensagem, gere um novo link.",
        InviteStatus.Expired =>
            $"O link expirou em {StudentDisplay.Date(view.InviteExpiresAtUtc!.Value)} sem ser usado. " +
            "Gere um novo link para o aluno criar a conta.",
        _ when view.InviteRevokedAtUtc is { } revoked =>
            $"O link foi cancelado em {StudentDisplay.Date(revoked)} e não funciona mais. " +
            "Gere um novo link quando quiser convidar o aluno.",
        _ => "Não há link de convite válido. Gere um novo link para o aluno criar a conta."
    };
}
