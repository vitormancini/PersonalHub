@page "/convite/{Token}"
@attribute [AllowAnonymous]
@layout AuthLayout
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(InviteRateLimiting.Policy)]
@using PersonalHub.Web.Domain.Students
@inject AcceptInviteHandler Handler
@inject NavigationManager Navigation

@* Página pública do aluno. SSR estático: o cookie de login precisa ser gravado numa resposta HTTP.
   O GET só mostra; aceitar exige POST com antiforgery (scanners de link abrem URLs sozinhos). *@

<PageTitle>Convite · PersonalHub</PageTitle>

<div class="ph-auth ph-invite">
    <header class="ph-auth-hero">
        <div class="ph-invite-inner">
            <PhLogo />
            @if (_view.State == InviteState.Valid)
            {
                <h1 class="ph-auth-hero-title">@_view.PersonalName convidou você</h1>
                <p class="ph-auth-hero-text">Acompanhe suas aulas e o demonstrativo do mês com seu personal.</p>
            }
        </div>
    </header>

    <main class="ph-auth-main">
        <div class="ph-invite-inner">
            @if (_view.State != InviteState.Valid && _postedForm is null)
            {
                var (title, text) = InvalidCopy(_view.State);
                <div class="ph-result">
                    <div class="ph-status-icon ph-status-warning" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 8v5M12 16.5h.01" /></svg>
                    </div>
                    <h1 class="ph-result-title">@title</h1>
                    <p class="ph-result-text">@text</p>
                </div>
                <a href="/entrar" class="ph-btn ph-btn-primary ph-btn-block">Ir para o login</a>
            }
            else
            {
                <div class="ph-email-box">
                    <span>@(_view.HasAccount ? "Convite para o e-mail" : "Sua conta será criada com o e-mail")</span>
                    <strong>@_view.Email</strong>
                </div>

                @if (_alreadyLinked)
                {
                    <div class="ph-alert ph-alert-danger" role="alert">
                        <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                        <p>Não foi possível aceitar este convite. Peça ao seu personal para conferir o seu cadastro.</p>
                    </div>
                }

                @if (_postedForm is not null ? _postedForm == ExistingForm : _view.HasAccount)
                {
                    <EditForm EditContext="_existingContext" FormName="@ExistingForm" OnSubmit="AcceptExistingAsync"
                              novalidate class="ph-form" data-ph-busy-form>
                        <div class="ph-alert ph-alert-info" role="status">
                            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
                            <p>Você já tem conta no PersonalHub. Entre com sua senha para aceitar o convite do @_view.PersonalName.</p>
                        </div>

                        @if (_loginOutcome == AcceptInviteOutcome.InvalidCredentials)
                        {
                            <div class="ph-alert ph-alert-danger" role="alert">
                                <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                                <p><strong>E-mail ou senha incorretos.</strong> Confira os dados e tente de novo.</p>
                            </div>
                        }
                        else if (_loginOutcome == AcceptInviteOutcome.LockedOut)
                        {
                            <div class="ph-alert ph-alert-warning" role="alert">
                                <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                <p><strong>Acesso bloqueado por 15 minutos</strong> após várias tentativas sem sucesso. Tente de novo depois desse prazo.</p>
                            </div>
                        }

                        @* Ajuda o gerenciador de senhas a associar a senha à conta certa. *@
                        <input type="email" name="username" value="@_view.Email" autocomplete="username" hidden readonly />

                        <div class="ph-field">
                            <label for="convite-senha-atual" class="ph-label">Senha</label>
                            <div class="ph-password">
                                <InputText id="convite-senha-atual" type="password" @bind-Value="Existing.Password" class="ph-input"
                                           autocomplete="current-password" aria-describedby="convite-senha-atual-error" />
                                <PasswordToggle For="convite-senha-atual" />
                            </div>
                            <ValidationMessage For="() => Existing.Password" id="convite-senha-atual-error" class="ph-field-error" />
                        </div>

                        <div class="ph-field">
                            <label class="ph-check ph-check-top">
                                <InputCheckbox id="convite-termos-existente" @bind-Value="Existing.AcceptTerms" class="ph-check-input"
                                               aria-describedby="convite-termos-existente-error" />
                                <span>Li e aceito os <a href="/termos" target="_blank" rel="noopener">Termos de Uso</a> e a <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>.</span>
                            </label>
                            <ValidationMessage For="() => Existing.AcceptTerms" id="convite-termos-existente-error" class="ph-field-error" />
                        </div>

                        <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Entrando…">
                            <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span class="ph-btn-text">Entrar e aceitar convite</span>
                        </button>
                    </EditForm>
                }
                else
                {
                    <EditForm EditContext="_newContext" FormName="@NewForm" OnSubmit="AcceptNewAsync"
                              novalidate class="ph-form" data-ph-busy-form>
                        <input type="email" name="username" value="@_view.Email" autocomplete="username" hidden readonly />

                        <div class="ph-field">
                            <label for="convite-nome" class="ph-label">Seu nome</label>
                            <InputText id="convite-nome" @bind-Value="New.Name" class="ph-input" autocomplete="name"
                                       autocapitalize="words" maxlength="150" aria-describedby="convite-nome-error" />
                            <ValidationMessage For="() => New.Name" id="convite-nome-error" class="ph-field-error" />
                        </div>

                        <div class="ph-field">
                            <label for="convite-senha" class="ph-label">Crie uma senha</label>
                            <div class="ph-password">
                                <InputText id="convite-senha" type="password" @bind-Value="New.Password" class="ph-input"
                                           autocomplete="new-password" aria-describedby="convite-senha-regras convite-senha-error" />
                                <PasswordToggle For="convite-senha" />
                            </div>
                            <ul id="convite-senha-regras" class="ph-rules" data-ph-password-rules="convite-senha"
                                aria-label="Regras da senha">
                                <li data-rule="length">8 ou mais caracteres</li>
                                <li data-rule="upper">Uma letra maiúscula</li>
                                <li data-rule="lower">Uma letra minúscula</li>
                                <li data-rule="digit">Um número</li>
                            </ul>
                            <ValidationMessage For="() => New.Password" id="convite-senha-error" class="ph-field-error" />
                        </div>

                        <div class="ph-field">
                            <label for="convite-confirmacao" class="ph-label">Confirme a senha</label>
                            <div class="ph-password">
                                <InputText id="convite-confirmacao" type="password" @bind-Value="New.ConfirmPassword" class="ph-input"
                                           autocomplete="new-password" aria-describedby="convite-confirmacao-error" />
                                <PasswordToggle For="convite-confirmacao" />
                            </div>
                            <ValidationMessage For="() => New.ConfirmPassword" id="convite-confirmacao-error" class="ph-field-error" />
                        </div>

                        <div class="ph-field">
                            <label class="ph-check ph-check-top">
                                <InputCheckbox id="convite-termos" @bind-Value="New.AcceptTerms" class="ph-check-input"
                                               aria-describedby="convite-termos-error" />
                                <span>Li e aceito os <a href="/termos" target="_blank" rel="noopener">Termos de Uso</a> e a <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>.</span>
                            </label>
                            <ValidationMessage For="() => New.AcceptTerms" id="convite-termos-error" class="ph-field-error" />
                        </div>

                        <button type="submit" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Criando conta…">
                            <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span class="ph-btn-text">Criar conta e entrar</span>
                        </button>
                    </EditForm>
                }
            }
        </div>
    </main>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string Token { get; set; } = default!;

    [SupplyParameterFromForm(FormName = NewForm)]
    private NewAccountInput New { get; set; } = default!;

    [SupplyParameterFromForm(FormName = ExistingForm)]
    private ExistingAccountInput Existing { get; set; } = default!;

    private const string NewForm = "nova-conta";
    private const string ExistingForm = "conta-existente";

    private InviteView _view = new(InviteState.NotFound);

    // Num POST, o Blazor só despacha o envio se o formulário enviado estiver na tela. Enquanto o handler não
    // decide, renderiza o formulário postado mesmo que o convite tenha expirado ou a conta passado a existir.
    private string? _postedForm;
    private EditContext _newContext = default!;
    private ValidationMessageStore _newMessages = default!;
    private EditContext _existingContext = default!;
    private ValidationMessageStore _existingMessages = default!;
    private AcceptInviteOutcome? _loginOutcome;
    private bool _alreadyLinked;

    protected override async Task OnInitializedAsync()
    {
        // O token está na URL: nenhuma página seguinte pode recebê-lo pelo Referer, e nada fica em cache.
        HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";
        HttpContext.Response.Headers.CacheControl = "no-store";
        HttpContext.Response.Headers["X-Robots-Tag"] = "noindex";

        _view = await Handler.GetAsync(Token, HttpContext.RequestAborted);

        var isPost = HttpMethods.IsPost(HttpContext.Request.Method);
        if (isPost && HttpContext.Request.HasFormContentType)
        {
            var posted = (await HttpContext.Request.ReadFormAsync(HttpContext.RequestAborted))["_handler"].ToString();
            _postedForm = posted is NewForm or ExistingForm ? posted : null;
        }

        New ??= new NewAccountInput { Name = isPost ? null : _view.StudentName };
        Existing ??= new ExistingAccountInput();
        _newContext = new EditContext(New);
        _newMessages = new ValidationMessageStore(_newContext);
        _existingContext = new EditContext(Existing);
        _existingMessages = new ValidationMessageStore(_existingContext);
    }

    private async Task AcceptNewAsync()
    {
        var result = await Handler.AcceptWithNewAccountAsync(Token, New, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        await ApplyAsync(result, _newContext, _newMessages);
        ClearPasswords();
    }

    private async Task AcceptExistingAsync()
    {
        var result = await Handler.AcceptWithExistingAccountAsync(Token, Existing, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        await ApplyAsync(result, _existingContext, _existingMessages);
        ClearPasswords();
    }

    private async Task ApplyAsync(AcceptInviteResult result, EditContext context, ValidationMessageStore messages)
    {
        _postedForm = null;
        switch (result.Outcome)
        {
            case AcceptInviteOutcome.Succeeded:
                Navigation.NavigateTo("/aluno");
                return;
            case AcceptInviteOutcome.InviteUnavailable:
                _view = new InviteView(result.State);
                return;
            case AcceptInviteOutcome.AccountExists:
                _view = await Handler.GetAsync(Token, HttpContext.RequestAborted);
                return;
            case AcceptInviteOutcome.AlreadyLinked:
                _alreadyLinked = true;
                return;
            case AcceptInviteOutcome.InvalidCredentials or AcceptInviteOutcome.LockedOut:
                _loginOutcome = result.Outcome;
                return;
            default:
                ServerValidation.Show(context, messages, result.Errors);
                return;
        }
    }

    // A senha nunca volta no HTML da resposta.
    private void ClearPasswords()
    {
        New.Password = New.ConfirmPassword = string.Empty;
        Existing.Password = string.Empty;
    }

    private static (string Title, string Text) InvalidCopy(InviteState state) => state switch
    {
        InviteState.Expired => ("Este convite expirou",
            "Convites valem por 7 dias. Peça ao seu personal para enviar um novo link."),
        InviteState.Used => ("Este convite já foi usado",
            "Sua conta já está criada. Entre com seu e-mail e senha."),
        _ => ("Convite não encontrado",
            "Confira se o link está completo ou peça ao seu personal para enviar um novo.")
    };
}
