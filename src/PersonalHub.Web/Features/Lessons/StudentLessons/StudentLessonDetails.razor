@page "/aluno/aulas/{LessonId:guid}"
@attribute [Authorize(Roles = AppRoles.Student)]
@layout StudentLayout
@using PersonalHub.Web.Domain.Lessons
@using PersonalHub.Web.Features.Authentication
@using PersonalHub.Web.Features.Lessons.LessonDetails
@using PersonalHub.Web.Features.Lessons.RespondLesson
@using PersonalHub.Web.Features.Students
@inject LessonDetailsQuery Query
@inject RespondLessonHandler Handler
@inject NavigationManager Navigation

@* O formulário "responder" fica sempre na página; o botão "Confirmar aula" só aparece enquanto a aula está
   pendente. Assim o POST de uma aula já respondida em outra aba chega ao handler, que responde AlreadyResponded. *@

<PersonalPageHeader Title="Aula" BackHref="/aluno/aulas" BackLabel="Voltar para minhas aulas" />

<form id="responder-aula" method="post" @formname="responder" @onsubmit="ConfirmAsync" data-ph-busy-form>
    <AntiforgeryToken />
</form>

@if (_view is null)
{
    return;
}

<div class="ph-detail">
    <StudentLessonNotice Code="@Aviso" />

    <div class="ph-lesson-head">
        <span class="ph-pill @LessonDisplay.StatusPillClass(_view.Status, _view.Deleted)">@LessonDisplay.StatusLabel(_view.Status, _view.Deleted)</span>
        <h2 class="ph-profile-name">@LessonDisplay.LongDate(_view.OccurredAtUtc) às @LessonDisplay.Time(_view.OccurredAtUtc)</h2>
        <p class="ph-lesson-when">Com @_view.PersonalName</p>
    </div>

    @if (_view.Deleted)
    {
        <div class="ph-alert ph-alert-muted">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /></svg>
            <div class="ph-alert-body">
                <p><strong>Excluída por @_view.PersonalName em @LessonDisplay.DayMonth(_view.DeletedAtUtc!.Value)</strong></p>
                @if (_view.DeletionReason is not null)
                {
                    <p class="ph-reason">Motivo: @_view.DeletionReason</p>
                }
                @if (_view.CreditedLater)
                {
                    <p>Foi cobrada no demonstrativo de @Billing.BillingDisplay.MonthNameLower(_view.BilledInMonth!.Value). O valor volta como crédito no próximo demonstrativo.</p>
                }
                else
                {
                    <p>Esta aula não será cobrada.</p>
                }
            </div>
        </div>
    }
    else if (_view.Status == LessonStatus.Approved)
    {
        <div class="ph-alert ph-alert-success">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m8 12 3 3 5-6" /></svg>
            <p>Você confirmou em @LessonDisplay.DayMonthTime(_view.RespondedAtUtc!.Value).</p>
        </div>
    }
    else if (_view.Status == LessonStatus.Rejected)
    {
        <div class="ph-alert ph-alert-danger">
            <svg class="ph-alert-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6M9 9l6 6" /></svg>
            <div class="ph-alert-body">
                <p><strong>Você recusou em @LessonDisplay.DayMonthTime(_view.RespondedAtUtc!.Value)</strong></p>
                <p class="ph-reason">Motivo: @_view.RejectionReason</p>
            </div>
        </div>
    }

    <section class="ph-section-card" aria-labelledby="dados">
        <h3 id="dados" class="ph-section-title">Dados</h3>
        <dl class="ph-facts ph-facts-2">
            <div>
                <dt>Valor</dt>
                <dd>@StudentDisplay.Money(_view.UnitPrice)</dd>
            </div>
            <div>
                <dt>Duração</dt>
                <dd>@LessonDisplay.Duration(_view.DurationMinutes)</dd>
            </div>
        </dl>
        <dl class="ph-facts">
            <div>
                <dt>Observação do personal</dt>
                <dd class="ph-dd-text">@(_view.Notes ?? "Sem observação")</dd>
            </div>
        </dl>
    </section>

    @if (_view.CanRespond)
    {
        <section class="ph-stack-tight" aria-label="Responder">
            <p class="ph-note">Ao confirmar, a aula entra na sua próxima cobrança. Depois de responder não dá para mudar.</p>
            <button type="submit" form="responder-aula" class="ph-btn ph-btn-primary ph-btn-block" data-ph-busy-text="Confirmando…">
                <span class="ph-btn-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span class="ph-btn-text">Confirmar aula</span>
            </button>
            <a href="/aluno/aulas/@LessonId/recusar" class="ph-btn ph-btn-danger-outline ph-btn-block">Recusar aula</a>
        </section>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid LessonId { get; set; }

    [SupplyParameterFromQuery(Name = "aviso")]
    private string? Aviso { get; set; }

    private LessonDetailsView? _view;

    private Guid UserId => CurrentUser.IdOf(HttpContext.User)!.Value;

    protected override async Task OnInitializedAsync()
    {
        _view = await Query.ForStudentAsync(UserId, LessonId, HttpContext.RequestAborted);
        if (_view is null && !HttpMethods.IsPost(HttpContext.Request.Method))
        {
            // Aula de outro aluno, inexistente, ou pendente excluída: mesma resposta.
            Navigation.NotFound();
        }
    }

    private async Task ConfirmAsync()
    {
        var outcome = await Handler.ApproveAsync(UserId, LessonId, HttpContext.TraceIdentifier, HttpContext.RequestAborted);
        var code = StudentLessonNotice.CodeFor(outcome, rejected: false);
        // Confirmada: volta para a lista com o aviso verde. Senão mostra a aula como está agora (se ainda visível).
        Navigation.NavigateTo(outcome == RespondLessonOutcome.AlreadyResponded
            ? $"/aluno/aulas/{LessonId}?aviso={code}"
            : $"/aluno/aulas?aviso={code}");
    }
}
